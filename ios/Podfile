platform :ios, '16.0'

# Firebase stopped publishing to CocoaPods in Oct 2026; 12.19.2+ are SPM-only.
# firebase_core pins 12.19.3, which does not exist on the CocoaPods CDN, so
# `pod install` fails to resolve. Every FlutterFire podspec honours this global
# before falling back to its hardcoded pin, so 12.19.0 (the last version
# published to CocoaPods) satisfies FirebaseAnalytics/Firebase/CoreOnly and its
# whole dependency tree.
$FirebaseSDKVersion = '12.19.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Solian', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Solian' do
  use_frameworks!
  use_modular_headers!

  pod 'Alamofire'
  pod 'Kingfisher', '~> 8.0'
  pod 'KingfisherWebP'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'SolianTests' do
    inherit! :search_paths
  end

  target 'SolianShareExtension' do
    inherit! :search_paths
  end

  target 'SolianNotificationService' do
    pod 'Kingfisher', '~> 8.0'
    pod 'KingfisherWebP'

    inherit! :search_paths
  end
end

target 'SolianWatchApp' do
  platform :watchos, '11.0'

  use_frameworks!
  use_modular_headers!

  pod 'Kingfisher', '~> 8.0'
  pod 'KingfisherWebP'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Workaround for https://github.com/flutter/flutter/issues/64502
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES' # <= this line

      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        ## dart: PermissionGroup.camera
        'PERMISSION_CAMERA=1',

        ## dart: PermissionGroup.microphone
        'PERMISSION_MICROPHONE=1',

        ## dart: PermissionGroup.photos
        'PERMISSION_PHOTOS=1',

        ## The 'PERMISSION_LOCATION' macro enables the `locationWhenInUse` and `locationAlways` permission. If
        ## the application only requires `locationWhenInUse`, only specify the `PERMISSION_LOCATION_WHENINUSE`
        ## macro.
        ##
        ## dart: [PermissionGroup.location, PermissionGroup.locationAlways, PermissionGroup.locationWhenInUse]
        'PERMISSION_LOCATION=1',
        'PERMISSION_LOCATION_WHENINUSE=1',

        ## dart: PermissionGroup.notification
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['WATCHOS_DEPLOYMENT_TARGET'] = '11.0'
    end

    # libwebp's headers use quoted sibling includes, which Xcode's module
    # verifier rejects for framework modules (libwebp-watchOS fails with
    # "double-quoted include ... in framework header"). It's a vendored C
    # library consumed by KingfisherWebP; skipping verification is the
    # standard workaround.
    if target.name.start_with?('libwebp')
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
      end
    end
  end
end
